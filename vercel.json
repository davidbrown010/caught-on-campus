{
  "headers": [
    {
      "source": "/control(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.notion.so https://notion.so https://*.notion.site https://*.notion-embeds.com"
        }
      ]
    }
  ]
}
